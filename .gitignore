# Engine caches and local editor state
.godot/
.DS_Store
.idea/
.vscode/

# Video/audio and generated distribution packages stay outside source control.
*.[mM][pP]3
*.[mM][pP]4
*.avi
*.mov
*.wav
exports/
builds/

# Local credentials/configuration
.env
.env.*
!.env.example
credentials/
*.p12
*.pfx

# Every test run writes a timestamped report into evidence/. Only the run at
# HEAD is worth keeping as the record, so ignore them by default and add the
# one being recorded with `git add -f`.
evidence/mechanics-*.json
evidence/keyboard-*.json

# Git cannot ignore by size: inspect staged files before committing (>25 MB).

# Film reel: keep the text evidence (beat sheet, coverage, QC, input logs),
# leave the media out. MP4 and MP3 are already excluded above; these are the
# compositor's intermediates and the 4K master, which live in course media
# storage and are identified in SUBMISSION.md by filename and SHA-256.
youtube/*/clips/
youtube/*/media/
youtube/*/exports/
youtube/*/mp3/
youtube/*/qc-sheet.png
youtube/*/_qc/frames/
