# Engine caches and local editor state
.godot/
.DS_Store
.idea/
.vscode/

# Video/audio and generated distribution packages stay outside source control.
*.[mM][pP]3
*.[mM][pP]4
*.avi
*.mov
*.wav
exports/
builds/

# Local credentials/configuration
.env
.env.*
!.env.example
credentials/
*.p12
*.pfx

# Every test run writes a timestamped report into evidence/. Only the run at
# HEAD is worth keeping as the record, so ignore them by default and add the
# one being recorded with `git add -f`.
evidence/mechanics-*.json
evidence/keyboard-*.json

# Git cannot ignore by size: inspect staged files before committing (>25 MB).
